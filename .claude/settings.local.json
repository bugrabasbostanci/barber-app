{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(rmdir:*)",
      "Bash(git add:*)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:www.prisma.io)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(npm run build:*)",
      "Bash(npx tsc:*)",
      "Bash(npm run lint)",
      "mcp__ide__getDiagnostics",
      "Bash(rm:*)"
    ],
    "deny": []
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "shadcn-ui"
  ]
}